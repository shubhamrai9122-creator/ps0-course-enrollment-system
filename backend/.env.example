# MongoDB Atlas connection string (Never commit actual passwords to git)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/course_enrollment_db?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Port for the Node/Express backend (Render provides PORT dynamically in production)
PORT=5001

# Allowed frontend origin(s) for CORS, comma separated (set to your Vercel URL in production)
CLIENT_URL=http://localhost:5173

# Environment mode: development | production
NODE_ENV=development

# Optional initial administrator seed configuration
# ADMIN_EMAIL=admin@institute.com
# ADMIN_PASSWORD=your_secure_password
